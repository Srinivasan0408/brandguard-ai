# ============================================================
# BRANDGUARD AI ENVIRONMENT VARIABLES EXAMPLE
# Inkloom AI Hackathon - Round 2: The Build
# Team: TECHSPARKZ
# ============================================================

# Environment Mode: 'development' or 'production'
ENVIRONMENT=development
PORT=8000
DEMO_MODE=true

# Database Persistence: Supabase (Optional)
# If left empty, BrandGuard AI automatically uses local SQLite persistence with pre-seeded NovaTech data.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional LLM API Configuration
# If left empty, BrandGuard AI runs 100% deterministically using rule & fact matchers.
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=none

# Frontend API URL (for Vite build)
# In local development, the Vite proxy directs /api to http://127.0.0.1:8000
# For deployed frontend (e.g., Vercel), set this to your deployed backend URL:
# VITE_API_URL=https://brandguard-api.onrender.com
VITE_API_URL=
